# Base de données Postgres (Supabase, Neon, Vercel Postgres, OVH, votre propre serveur...)
DATABASE_URL="postgresql://user:password@host:5432/archives_carddass"

# Chaîne aléatoire longue et secrète, utilisée pour signer les sessions admin.
# Générez-en une avec : openssl rand -base64 48
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"

# Compte admin créé automatiquement par "npm run seed" (à changer ensuite dans l'app)
SEED_ADMIN_EMAIL="admin@votredomaine.fr"
SEED_ADMIN_PASSWORD="changez-moi-123"

# --- Stockage des images des scans (optionnel en local) ---
# Laissez ces variables vides pour stocker les images dans public/uploads en développement.
# En production, configurez un stockage compatible S3 (Supabase Storage, Cloudflare R2,
# OVH Object Storage, MinIO...) :
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL_BASE=""

# --- Formulaire de contact (page Informations) ---
# Utilise votre compte Gmail en arrière-plan pour envoyer les messages, sans jamais
# exposer l'adresse au public. Nécessite un "mot de passe d'application" Gmail
# (pas votre mot de passe habituel) : activez la validation en 2 étapes sur votre
# compte Google, puis générez-en un sur myaccount.google.com/apppasswords
CONTACT_EMAIL_USER="votre-adresse@gmail.com"
CONTACT_EMAIL_APP_PASSWORD=""

# --- Traduction automatique (présentation des collections) ---
# Clé API Anthropic (console.anthropic.com), utilisée pour traduire automatiquement
# le texte de présentation d'une collection en anglais, chinois traditionnel et
# chinois simplifié. Sans cette clé, le texte reste affiché en français dans toutes
# les langues (aucune erreur, juste pas de traduction).
ANTHROPIC_API_KEY=""

# --- Filigrane automatique (optionnel) ---
# Si présent et à "true", désactive complètement le filigrane au niveau du serveur,
# quelle que soit la case cochée dans l'admin. Laissez vide/absent sinon.
DISABLE_WATERMARK=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Fonctionne avec n'importe quelle base Postgres (Supabase, Neon, Vercel Postgres, OVH...).
  // Pour tester en local sans serveur Postgres, vous pouvez temporairement mettre
  // provider = "sqlite" et url = "file:./dev.db"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collection {
  id              String   @id @default(cuid())
  nom             String
  annee           String?
  editeur         String?
  pays            String?
  total           Int?
  cover           String?
  dos             String?
  dosHD           String?
  description     String? // texte saisi par l'admin, toujours en français
  descriptionEn   String? // traduction automatique (anglais)
  descriptionZhTW String? // traduction automatique (chinois traditionnel)
  descriptionZhCN String? // traduction automatique (chinois simplifié)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cards           Card[]
  activityEvents  ActivityEvent[]
}

model Card {
  id              String     @id @default(cuid())
  numero          String
  personnagePrincipalId String?
  personnagePrincipal   Character?      @relation("PrincipalCharacter", fields: [personnagePrincipalId], references: [id], onDelete: SetNull)
  personnagesSecondaires CardCharacter[]
  rarete          String     @default("Commune")
  description     String? // texte saisi par l'admin, toujours en français
  descriptionEn   String? // traduction automatique (anglais)
  descriptionZhTW String? // traduction automatique (chinois traditionnel)
  descriptionZhCN String? // traduction automatique (chinois simplifié)
  image           String?
  imageHD         String?
  dos             String? // visuel de dos propre à cette carte, si différent de celui de la série
  dosHD           String?
  contributeur    String? // pseudo/nom optionnel de la personne ayant fourni le scan, affiché publiquement si renseigné
  collectionId    String
  collection      Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reports         Report[]
  userCards       UserCard[]
  submissions     CardSubmission[]
  listings        CardListing[]
  notifications   Notification[]
  priceHistory    PriceHistory[]
  activityEvents  ActivityEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([collectionId])
  @@index([rarete])
  @@index([personnagePrincipalId])
}

// Liste maîtresse des personnages (DBZ et au-delà), gérée depuis l'admin. Une carte a un
// personnage "principal" (celui affiché en priorité partout sur le site) et, si plusieurs
// personnages apparaissent dessus, des personnages "secondaires" via CardCharacter.
// personnagePrincipalId est volontairement optionnel : une carte importée en masse peut
// rester sans personnage défini jusqu'à ce qu'on le choisisse plus tard dans l'admin.
model Character {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  primaryCards   Card[]          @relation("PrincipalCharacter")
  secondaryCards CardCharacter[]
}

model CardCharacter {
  id          String    @id @default(cuid())
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([cardId, characterId])
  @@index([cardId])
  @@index([characterId])
}

// Compte utilisateur public (distinct des comptes admin) : permet à un visiteur de suivre
// sa propre collection et sa liste de cartes recherchées, avec une page profil publique.
model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  avatar       String?
  bio          String?
  createdAt    DateTime   @default(now())
  cards        UserCard[]
  submissions  CardSubmission[]
  listings     CardListing[]
  notifications Notification[]
  ratingsGiven    UserRating[] @relation("RatingsGiven")
  ratingsReceived UserRating[] @relation("RatingsReceived")
  reportsSent     UserReport[] @relation("UserReportsSent")
  reportsReceived UserReport[] @relation("UserReportsReceived")
  activityEvents  ActivityEvent[]
}

// Une ligne par carte suivie par un utilisateur, avec son statut : "owned" (je l'ai) ou
// "wanted" (je la recherche). Une carte donnée ne peut avoir qu'un seul statut à la fois
// pour un même utilisateur (contrainte unique userId+cardId).
model UserCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  status    String // "owned" | "wanted"
  createdAt DateTime @default(now())

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
  @@index([status])
}

// Adresses e-mail bannies par l'admin : empêche à la fois la connexion et une nouvelle
// inscription avec cette adresse. Le compte utilisateur correspondant est supprimé au
// moment du bannissement (voir /api/admin/users/[id]/ban) ; cette table ne fait que
// mémoriser l'adresse pour bloquer un retour.
model BannedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Annonce achat/vente d'un membre pour une carte précise : soit il la recherche à
// l'achat ("buyer"), soit il en propose une à la vente ("seller", avec état et prix). Une
// seule annonce par (carte, utilisateur) — en changer remplace la précédente plutôt que
// d'en cumuler plusieurs, comme pour UserCard.
model CardListing {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "buyer" | "seller"
  condition String? // uniquement pour "seller" : Satisfaisant | Bon etat | Tres bon etat | Neuve
  price     Float? // uniquement pour "seller"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, userId])
  @@index([cardId])
  @@index([userId])
  @@index([type])
}

// Notification en site pour un utilisateur — pour l'instant un seul type : une carte qu'il
// recherche vient d'être mise en vente par quelqu'un d'autre (voir POST .../listings).
// Pensé pour accueillir d'autres types plus tard sans changer la structure.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "card_for_sale"
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

// Historique de la côte "neuve" calculée d'une carte (voir lib/cote.js) : un point ajouté
// à chaque fois qu'une annonce en Très bon état ou Neuve change et fait varier la côte —
// alimente le graphique d'évolution du prix sur la fiche carte.
model PriceHistory {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cote       Float
  sampleSize Int
  createdAt  DateTime @default(now())

  @@index([cardId])
}

// Avis d'un membre sur un autre après un contact/échange : simple pouce haut/bas avec un
// commentaire optionnel. Un seul avis par (auteur, cible) — le refaire remplace le
// précédent plutôt que d'en cumuler plusieurs pour la même relation.
model UserRating {
  id        String   @id @default(cuid())
  raterId   String
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("RatingsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  positive  Boolean
  comment   String?
  createdAt DateTime @default(now())

  @@unique([raterId, targetId])
  @@index([targetId])
}

// Signalement d'un membre (comportement, arnaque suspectée...) — distinct du signalement
// d'une carte (voir Report), traité dans son propre onglet admin.
model UserReport {
  id             String   @id @default(cuid())
  reportedUserId String
  reportedUser   User     @relation("UserReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporterUserId String?
  reporterUser   User?    @relation("UserReportsSent", fields: [reporterUserId], references: [id], onDelete: SetNull)
  message        String
  status         String   @default("nouveau") // nouveau | traite | ignore
  createdAt      DateTime @default(now())

  @@index([reportedUserId])
  @@index([status])
}

// Événement affiché dans le fil d'activité public de la page d'accueil : un scan validé,
// une collection complétée, une nouvelle mise en vente. Alimenté au moment de l'action
// (voir les routes correspondantes), pas recalculé après coup.
model ActivityEvent {
  id           String      @id @default(cuid())
  type         String // "scan_approved" | "collection_completed" | "card_for_sale"
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  cardId       String?
  card         Card?       @relation(fields: [cardId], references: [id], onDelete: SetNull)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([createdAt])
}

// Scan proposé par un utilisateur pour une carte (typiquement une carte "recherchée", sans
// visuel). Traité comme un import classique (redimensionnement/compression via la même
// fonction que l'admin), mais reste en attente ("pending") tant qu'un admin ne l'a pas
// validé — voir /admin/scans. Une seule ligne par (carte, utilisateur) : un nouvel envoi
// remplace le précédent tant qu'il n'a pas encore été traité.
model CardSubmission {
  id         String    @id @default(cuid())
  cardId     String
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  image      String
  imageHD    String?
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@unique([cardId, userId])
  @@index([cardId])
  @@index([userId])
  @@index([status])
}

model Report {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  message   String
  contact   String?
  status    String   @default("nouveau") // nouveau | traite | ignore
  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([status])
}

model AdminUser {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

// Statistiques de fréquentation, volontairement minimalistes et anonymes :
// pas d'adresse IP stockée, pas d'identifiant lié à une personne. "visitorId"
// est un jeton aléatoire généré côté navigateur (non rattaché à une identité),
// utilisé uniquement pour distinguer visiteurs uniques et vues de page.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // "page_view" | "hd_download"
  path      String?
  country   String? // code pays ISO (ex. "TW"), déduit par Vercel, jamais l'IP elle-même
  visitorId String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([country])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Fonctionne avec n'importe quelle base Postgres (Supabase, Neon, Vercel Postgres, OVH...).
  // Pour tester en local sans serveur Postgres, vous pouvez temporairement mettre
  // provider = "sqlite" et url = "file:./dev.db"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collection {
  id        String   @id @default(cuid())
  nom       String
  annee     String?
  editeur   String?
  pays      String?
  total     Int?
  cover     String?
  dos       String?
  dosHD     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
}

model Card {
  id           String     @id @default(cuid())
  numero       String
  personnage   String
  rarete       String     @default("Commune")
  description  String?
  image        String?
  imageHD      String?
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reports      Report[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId])
  @@index([rarete])
  @@index([personnage])
}

model Report {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  message   String
  contact   String?
  status    String   @default("nouveau") // nouveau | traite | ignore
  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([status])
}

model AdminUser {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}
